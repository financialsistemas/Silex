{
    "name": "silex/silex",
    "description": "The PHP micro-framework based on the Symfony Components",
    "keywords": ["microframework"],
    "homepage": "https://silex.symfony.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Fabien Potencier",
            "email": "fabien@symfony.com"
        },
        {
            "name": "Igor Wiedler",
            "email": "igor@wiedler.ch"
        }
    ],
    "require": {
        "php": ">=8.0",
        "pimple/pimple": "^3.0",
        "symfony/event-dispatcher": "^6.0",
        "symfony/http-foundation": "^6.0",
        "symfony/http-kernel": "^6.0",
        "symfony/routing": "^6.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "doctrine/dbal": "^2.2",
        "monolog/monolog": "^1.4.1",
        "phpunit/phpunit": "^9.6",
        "rector/rector": "^2.0",
        "swiftmailer/swiftmailer": "^6",
        "symfony/asset": "^6.0",
        "symfony/browser-kit": "^6.0",
        "symfony/config": "^6.0",
        "symfony/console": "^6.0",
        "symfony/css-selector": "^6.0",
        "symfony/doctrine-bridge": "^6.0",
        "symfony/dom-crawler": "^6.0",
        "symfony/expression-language": "^6.0",
        "symfony/finder": "^6.0",
        "symfony/form": "^6.0",
        "symfony/intl": "^6.0",
        "symfony/mailer": "^6.0",
        "symfony/monolog-bridge": "^6.0",
        "symfony/options-resolver": "^6.0",
        "symfony/phpunit-bridge": "^6.0",
        "symfony/process": "^6.0",
        "symfony/security-bundle": "^6.0",
        "symfony/serializer": "^6.0",
        "symfony/translation": "^6.0",
        "symfony/twig-bridge": "^6.0",
        "symfony/validator": "^6.0",
        "symfony/var-dumper": "^6.0",
        "symfony/web-link": "^6.0",
        "twig/twig": "^3.11.3"
    },
    "replace": {
        "silex/api": "self.version",
        "silex/providers": "self.version"
    },
    "autoload": {
        "psr-4": { "Silex\\": "src/Silex" }
    },
    "autoload-dev" : {
        "psr-4": { "Silex\\Tests\\" : "tests/Silex/Tests" }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.3.x-dev",
            "dev-feat/update-symfony": "2.3.x-dev"
        }
    }
}